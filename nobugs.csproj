<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 游戏基于 Unity 6000，Assembly-CSharp 面向 netstandard2.1 -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>nobugs</AssemblyName>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>nobugs</RootNamespace>
    <Product>PEAK NoBugs</Product>
    <AssemblyTitle>PEAK NoBugs</AssemblyTitle>
    <Description>移除 PEAK 中的所有昆虫（蜘蛛、蝎子、甲虫、蜂群、蚁狮）</Description>
  </PropertyGroup>

  <!-- decompiled/ 只是 dnSpy 反编译出来的参考源码，不参与编译 -->
  <ItemGroup>
    <Compile Remove="decompiled\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx / Harmony 改用 lib 下的真实运行时 DLL（见下方 Reference），
         此处只保留生成 MyPluginInfo 的 PluginInfoProps 与分析器 -->
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.3.15" IncludeAssets="compile" />
  </ItemGroup>

  <!--
    本地程序集引用，全部取自游戏/BepInEx 实际安装目录，保证编译期与运行时版本一致。
    Private=false：不复制到输出目录，插件 DLL 保持单文件。
  -->
  <ItemGroup>
    <!-- BepInEx 5.4.23.3：BaseUnityPlugin / BepInPlugin / ConfigEntry / ManualLogSource -->
    <Reference Include="BepInEx">
      <HintPath>lib\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- HarmonyX 2.9.0：Harmony / HarmonyPatch / HarmonyPrefix / HarmonyPostfix -->
    <Reference Include="0Harmony">
      <HintPath>lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 游戏逻辑：Spider / Scorpion / Beetle / Beehive / BeeSwarm / Antlion / Mob -->
    <Reference Include="Assembly-CSharp">
      <HintPath>lib\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Mob 继承 MonoBehaviourPunCallbacks、BeeSwarm 继承 MonoBehaviourPun，必须引用 -->
    <Reference Include="PhotonUnityNetworking">
      <HintPath>lib\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>lib\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
